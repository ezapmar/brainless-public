# brainless configuration. Copy to your shell profile or a systemd EnvironmentFile.
# Every variable is optional; the defaults run the engine on one machine.

# Where the vault lives (default: ~/projects/brainless).
BRAINLESS_VAULT=~/projects/brainless

# Who the vault belongs to and the language of generated text (tr or en).
# Can also live in <vault>/_Agent-Context/PROFILE.md frontmatter.
BRAINLESS_OWNER_NAME=the owner
BRAINLESS_OUTPUT_LANG=en

# LLM backend (tools/llm.py).
#   claude-cli        : the claude CLI, signed in with a subscription (default)
#   openai-compatible : any /chat/completions endpoint (OpenAI, Together, Grok, Ollama, LM Studio)
#   goose             : the goose CLI running a model on this machine, nothing leaves it
BRAINLESS_LLM_PROVIDER=claude-cli
#BRAINLESS_LLM_BASE_URL=http://localhost:11434/v1
#BRAINLESS_LLM_API_KEY=
#BRAINLESS_LLM_MODEL=
# Goose: 'local' serves a GGUF downloaded with `goose local-models download`.
#BRAINLESS_GOOSE_PROVIDER=local
#BRAINLESS_GOOSE_MODEL=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M

# Per-lane routing. Each call site names a lane; see `python3 tools/llm.py --lanes`.
# The variable is the lane name upper-cased, dashes turned into underscores, and it
# overrides BRAINLESS_LLM_PROVIDER for that lane alone. Use it to keep the sensitive,
# short prompts on a local model while long prose stays on a large one.
#BRAINLESS_LLM_PROVIDER_NOTE_CLASSIFY=goose
#BRAINLESS_CLAUDE_MODEL_RESEARCH_SALVO=claude-opus-5
#BRAINLESS_GOOSE_MODEL_NOTE_CLASSIFY=unsloth/Qwen3-0.6B-GGUF:Q4_K_M

# Second provider to try when the first one fails, globally or per lane ("none" to
# disable for a lane). Cloud may degrade to local; local never escalates to cloud,
# because a lane pinned local was pinned for privacy. Override only if you mean it.
#BRAINLESS_LLM_FALLBACK=goose
#BRAINLESS_LLM_FALLBACK_COMPILE=none
#BRAINLESS_LLM_ALLOW_CLOUD_FALLBACK=1
# Local inference is slow; caller timeouts are multiplied by this factor.
#BRAINLESS_LOCAL_TIMEOUT_FACTOR=3

# Largest prompt slice per source file for the wiki compiler (characters).
BRAINLESS_LLM_MAX_CHARS=30000
