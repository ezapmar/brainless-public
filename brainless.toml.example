# brainless.toml: copy to brainless.toml at the vault root and edit.
# This is the single routing file for model lanes (read by tools/config.py).
# Precedence is environment > this file > the tool's default, so a lane set here
# holds even when a job or an agent runs without sourcing .agents/scripts/env.sh.
# No secrets in this file: it is committed with the vault.

[llm]
# Local model server (Gemma 4 12B on llama-server, the "llm" launchd job).
base_url = "http://127.0.0.1:8080/v1"
model = "gemma-4-12b"

# Fail-closed list (tools/llm.py). A lane named here may only run on a local
# provider: if its provider resolves to a cloud one (an env override, a typo,
# a missing block below), the call is refused and logged, and no fallback can
# send its text to the cloud. tools/health_check.py turns RED on drift.
local_only = [
  "note-classify",
  "dreaming-judge",
  "compile-aliases",
  "compile-local",
  "capture-note",
  "capture-photo",
  "spiky-actions",
  "ask",
]

[llm.lanes.note-classify]
provider = "openai-compatible"

[llm.lanes.compile-local]
# The summary, entity, concept and assignment work for a source listed under
# cloud_exclude in _Agent-Context/PROFILE.md (or marked privacy: personal).
# Being in local_only above makes it fail closed on the Mac.
provider = "openai-compatible"

[llm.lanes.dreaming-judge]
provider = "openai-compatible"

[llm.lanes.compile-aliases]
provider = "openai-compatible"

[llm.lanes.capture-note]
provider = "openai-compatible"

[llm.lanes.capture-photo]
provider = "openai-compatible"

[llm.lanes.spiky-actions]
provider = "openai-compatible"

[llm.lanes.ask]
provider = "openai-compatible"

# Other lanes (compile, compile-concept, nightly, close-out, reconcile,
# resurface, research, thinking loop, digests, content) default to claude-cli.
# Inspect active routing at any time:
#   python3 tools/llm.py --lanes
#   python3 tools/llm.py --probe note-classify
