[Unit]
Description=brainless: transcribe queued YouTube and podcast links
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# One job per run: a two-hour episode is a long CPU run, and the capture
# workers must keep their own ticks. The queue drains over several runs.
Nice=10
TimeoutStartSec=5h
# git lock lives in worker_job.sh, wrapping only pull+backup (not the tool run).
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/media_import.py run --max 1
