[Unit]
Description=brainless: weekly resurface of old notes
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# git lock lives in worker_job.sh, wrapping only pull+backup (not the tool run).
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/resurface.py
