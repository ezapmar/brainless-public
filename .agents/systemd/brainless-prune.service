[Unit]
Description=brainless: weekly pile count and archive pass
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# Applies since 2026-10-04. The first two weeks were a dry run: the candidates
# were listed in the scorecard and nothing moved, so six Spiky reports sat in
# Inbox past their date. Nothing is deleted; every move is in .wiki/_archive/LOG.md.
# Drop --apply to go back to listing only.
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/wiki_prune.py --count --archive --apply
