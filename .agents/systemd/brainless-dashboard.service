[Unit]
Description=brainless: rebuild the personal dashboard
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# git lock lives in worker_job.sh, wrapping only pull+backup (not the tool run).
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/build_dashboard.py
