[Unit]
Description=brainless: weekly wiki lint with fixes
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# flock serialises git against the 30 minute backup timer (pull, commit, push).
ExecStart=/usr/bin/flock -w 300 %h/.brainless-git.lock /bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/lint_wiki.py --fix --fix-links
