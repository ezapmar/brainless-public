[Unit]
Description=brainless: night dialectic round on the worker's local model (experiment)
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# Only the persona lane goes local; the moderator's synthesis and the usability
# judge stay on the cloud provider so the experiment is graded by the same
# model that grades the day rounds. Local calls are slow: six personas, two
# rounds, one at a time, is about an hour on the 4B model.
Environment=BRAINLESS_LLM_PROVIDER_DIALECTIC_PERSONA=goose
# git lock lives in worker_job.sh, wrapping only pull+backup (not the tool run).
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh tools/dialectic.py --run night
