[Unit]
Description=brainless: daily CRM snapshot (read-only, no LLM)
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
# No-op without ~/.config/brainless/<provider>_api_token, so the unit is safe
# to enable on a worker that has no CRM credentials. On a laptop-first setup
# the hourly cron_wrapper.sh run is the live producer; this is the worker path.
# git lock lives in worker_job.sh, wrapping only pull+backup (not the tool run).
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh .agents/scripts/crm_capture.py
ExecStartPost=/bin/bash %h/projects/brainless/.agents/scripts/buzz_crm_sync.sh
