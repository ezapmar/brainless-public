[Unit]
Description=brainless: weekly thinking question (Telegram)
After=network-online.target
OnFailure=brainless-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/brainless
ExecStart=/bin/bash %h/projects/brainless/.agents/scripts/worker_job.sh .agents/scripts/thinking_loop.py --ask
