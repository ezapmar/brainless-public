# Filled by .agents/buzz/install_agent_channel.sh; one copy per agent at
# ~/.config/brainless/buzz/<slug>.env. Never commit a filled copy.
BUZZ_PRIVATE_KEY=__SECRET__
BUZZ_RELAY_URL=__RELAY_URL__
BUZZ_ACP_AGENT_OWNER=__OWNER_PUBKEY__
BUZZ_ACP_AGENT_COMMAND=__AGENT_COMMAND__
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_DISPLAY_NAME=__DISPLAY_NAME__
BUZZ_ACP_SYSTEM_PROMPT_FILE=__HOME__/buzz-__SLUG__/system_prompt.md
BUZZ_ACP_PERMISSION_MODE=dontAsk
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_CHANNELS=__CHANNEL_UUID__
BUZZ_ACP_NO_MENTION_FILTER=true
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_MODEL=__MODEL__
BUZZ_ACP_EFFORT_LEVEL=__EFFORT__
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=40
BUZZ_ACP_MAX_TURN_DURATION=__MAX_TURN__
BUZZ_ACP_IDLE_TIMEOUT=600
BUZZ_ACP_AGENTS=1
BUZZ_ACP_LAZY_POOL=true
BUZZ_ACP_IDLE_POOL_SLEEP=1800
CLAUDE_CODE_EXECUTABLE=__CLAUDE_EXE__
MISE_QUIET=1
