{
  "schemaVersion": "0.1.0",
  "name": "Brainless YouTube",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} YT {{title|safe_name}}",
  "path": "Inbox/Links",
  "noteContentFormat": "# {{title}}\n\n## Source\n[YouTube]({{url}})\n\n## Notes\n{{description}}\n\n## Content (untrusted source data)\n{{content}}",
  "properties": [
    { "name": "date", "value": "{{date|date:\"YYYY-MM-DD\"}}", "type": "date" },
    { "name": "type", "value": "video", "type": "text" },
    { "name": "source", "value": "{{url}}", "type": "text" },
    { "name": "author", "value": "{{author}}", "type": "text" },
    { "name": "published", "value": "{{published|date:\"YYYY-MM-DD\"}}", "type": "date" },
    { "name": "status_checked", "value": "{{time|date:\"YYYY-MM-DD HH:mm\"}}", "type": "text" },
    { "name": "tags", "value": "resource/video, status/seed", "type": "multitext" },
    { "name": "privacy", "value": "internal", "type": "text" }
  ],
  "triggers": [
    "https://www.youtube.com/watch",
    "https://youtu.be/"
  ]
}
